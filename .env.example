# Coinbase Developer Platform sandbox configuration. Keep secrets server-side.
CDP_API_KEY_ID=PASTE_YOUR_API_KEY_ID_HERE
CDP_API_KEY_SECRET=PASTE_YOUR_API_KEY_SECRET_HERE
CDP_ACCOUNT_ID=account_3b05af6c-1cc0-4dd9-9c97-569cba8259f2
COINBASE_ENV=sandbox
ESCROW_MODE=sandbox
NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://user:password@host:5432/database
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
# Optional second administrator role. Supported roles are member, admin, and super_admin.
# The seeded ADMIN_EMAIL account is created as admin.
# Escrow releases currently use the explicit sandbox ledger adapter when ESCROW_MODE=sandbox.
# Required only when ESCROW_MODE=real. Leave blank for sandbox.
ESCROW_BTC_ADDRESS=
ESCROW_USDT_ADDRESS=
BTC_USD_RATE=